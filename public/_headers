# Cloudflare static-asset headers (wrangler assets serve this file, never as a page).
# The script-src hash is the inline theme script in index.html: edit that script
# (even whitespace) and the hash must be recomputed, or the theme flashes.
# e2e/security-headers.spec.ts checks the two stay in step.
# style-src needs 'unsafe-inline' for React style attributes (progress bars).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-FPJARR7gSVVhKWh1+W/9Q+Ifz21BeOK1n05Di27rj2w='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
